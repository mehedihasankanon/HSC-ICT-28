    {
      "id": "gU3xBA7XRfhNKtLFitdBf",
      "type": "text",
      "x": 436.1735717638796,
      "y": 1501.415591416712,
      "width": 608.7196044921875,
      "height": 725,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aN",
      "roundness": null,
      "seed": 384828610,
      "version": 1014,
      "versionNonce": 1240374174,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1795713297379,
      "link": null,
      "locked": false,
      "text": "High Level -> \n\n(5G) -> Prolog, Mercury, OPS5\n\n(4G) -> R, MATLAB, SQL(modern sql -> turing complete)\n\n\n(3G) -> Mid Level Language -> C, C++, Rust, Go,\n Python, Java, Ruby, PHP, JavaScript (10 days)\n\nC -> complex data support -> limited\n\nBjarne Stroustrup -> C -> class and object systems -> OOP\n\nc = a + b\n\n\n---------------\nLow Level -> \n\n(2G) Assembly Code -> replace 0/1 with a few commonly known\ninstructions -> add, sub, move, jump -> register based\n\nMIPS Assembly -> \"add $t0, $t1, $t2\" -> 80s architecture\n\n$t0 -> 8th register\n$ta -> assembler temporary register (2 no. register)\n\n(1G) Machine Code -> 0/1 diye instruction ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "High Level -> \n\n(5G) -> Prolog, Mercury, OPS5\n\n(4G) -> R, MATLAB, SQL(modern sql -> turing complete)\n\n\n(3G) -> Mid Level Language -> C, C++, Rust, Go,\n Python, Java, Ruby, PHP, JavaScript (10 days)\n\nC -> complex data support -> limited\n\nBjarne Stroustrup -> C -> class and object systems -> OOP\n\nc = a + b\n\n\n---------------\nLow Level -> \n\n(2G) Assembly Code -> replace 0/1 with a few commonly known\ninstructions -> add, sub, move, jump -> register based\n\nMIPS Assembly -> \"add $t0, $t1, $t2\" -> 80s architecture\n\n$t0 -> 8th register\n$ta -> assembler temporary register (2 no. register)\n\n(1G) Machine Code -> 0/1 diye instruction ",
      "autoResize": true,
      "lineHeight": 1.25
    },
